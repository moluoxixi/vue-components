{
  "name": "@moluoxixi/components",
  "type": "module",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/components"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto-loaders": {
      "source": "./auto-loaders.ts",
      "types": "./dist/auto-loaders.d.ts",
      "import": "./dist/auto-loaders.js"
    },
    "./playground-manifest": {
      "types": "./dist/playground-manifest.d.ts",
      "import": "./dist/playground-manifest.js"
    },
    "./styles": {
      "import": "./dist/components.css"
    },
    "./AntdConfigForm": {
      "source": "./src/AntdConfigForm/index.ts",
      "types": "./dist/src/AntdConfigForm/index.d.ts",
      "import": "./dist/AntdConfigForm.js"
    },
    "./ConfigTable": {
      "source": "./src/ConfigTable/index.ts",
      "types": "./dist/src/ConfigTable/index.d.ts",
      "import": "./dist/ConfigTable.js"
    },
    "./CopyText": {
      "source": "./src/CopyText/index.ts",
      "types": "./dist/src/CopyText/index.d.ts",
      "import": "./dist/CopyText.js"
    },
    "./DateRangePicker": {
      "source": "./src/DateRangePicker/index.ts",
      "types": "./dist/src/DateRangePicker/index.d.ts",
      "import": "./dist/DateRangePicker.js"
    },
    "./ElementConfigForm": {
      "source": "./src/ElementConfigForm/index.ts",
      "types": "./dist/src/ElementConfigForm/index.d.ts",
      "import": "./dist/ElementConfigForm.js"
    },
    "./EnterNextContainer": {
      "source": "./src/EnterNextContainer/index.ts",
      "types": "./dist/src/EnterNextContainer/index.d.ts",
      "import": "./dist/EnterNextContainer.js"
    },
    "./HeadlessCopyText": {
      "source": "./src/HeadlessCopyText/index.ts",
      "types": "./dist/src/HeadlessCopyText/index.d.ts",
      "import": "./dist/HeadlessCopyText.js"
    },
    "./HeadlessTable": {
      "source": "./src/HeadlessTable/index.ts",
      "types": "./dist/src/HeadlessTable/index.d.ts",
      "import": "./dist/HeadlessTable.js"
    },
    "./PopoverTableSelect": {
      "source": "./src/PopoverTableSelect/index.ts",
      "types": "./dist/src/PopoverTableSelect/index.d.ts",
      "import": "./dist/PopoverTableSelect.js"
    },
    "./RequestCascader": {
      "source": "./src/RequestCascader/index.ts",
      "types": "./dist/src/RequestCascader/index.d.ts",
      "import": "./dist/RequestCascader.js"
    },
    "./RequestSelectV2": {
      "source": "./src/RequestSelectV2/index.ts",
      "types": "./dist/src/RequestSelectV2/index.d.ts",
      "import": "./dist/RequestSelectV2.js"
    },
    "./RequestTreeSelect": {
      "source": "./src/RequestTreeSelect/index.ts",
      "types": "./dist/src/RequestTreeSelect/index.d.ts",
      "import": "./dist/RequestTreeSelect.js"
    },
    "./RichTextEditor": {
      "source": "./src/RichTextEditor/index.ts",
      "types": "./dist/src/RichTextEditor/index.d.ts",
      "import": "./dist/RichTextEditor.js"
    },
    "./configForm": {
      "source": "./src/configForm.ts",
      "types": "./dist/src/configForm.d.ts",
      "import": "./dist/configForm.js"
    },
    "./element": {
      "source": "./element.ts",
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./antd": {
      "source": "./antd.ts",
      "types": "./dist/antd.d.ts",
      "import": "./dist/antd.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "antd.ts",
    "auto-loaders.ts",
    "dist",
    "element.ts",
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "node scripts/generate-playground-manifest.mjs && node scripts/finalize-declarations.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.2.0",
    "element-plus": "^2.9.0",
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:ui",
    "@lucide/vue": "catalog:ui",
    "@moluoxixi/config-form": "workspace:*",
    "@moluoxixi/config-form-headless": "workspace:*",
    "@moluoxixi/hooks": "workspace:*",
    "@tiptap/core": "catalog:ui",
    "@tiptap/extension-placeholder": "catalog:ui",
    "@tiptap/extension-text-align": "catalog:ui",
    "@tiptap/pm": "catalog:ui",
    "@tiptap/starter-kit": "catalog:ui",
    "@tiptap/vue-3": "catalog:ui",
    "dayjs": "catalog:build",
    "sortablejs": "catalog:"
  },
  "devDependencies": {
    "@tanstack/vue-query": "catalog:data",
    "@types/sortablejs": "catalog:",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "ant-design-vue": "catalog:ui",
    "element-plus": "catalog:ui",
    "esbuild": "catalog:dev",
    "happy-dom": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:build",
    "vue-tsc": "catalog:dev",
    "zod": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
