{
  "name": "@moluoxixi/config-form-local",
  "type": "module",
  "version": "0.1.1",
  "description": "ConfigForm local workspace server, source CLI and MCP tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/ConfigForm/local"
  },
  "sideEffects": [
    "./dist/cli.js",
    "./src/cli/index.ts",
    "./src/services/cli.ts"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "source": "./src/mcp/index.ts",
      "types": "./dist/src/mcp/index.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "config-form": "./dist/cli.js"
  },
  "files": [
    "dist",
    "index.ts",
    "src"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "vite build && node scripts/build-designer.mjs",
    "build:lib": "vite build",
    "postbuild": "pnpm -w finalize:declarations --manifest \"$npm_package_json\"",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "verify:source": "node scripts/verify-source-consumers.mjs",
    "verify:pack": "node scripts/verify-packed-sdk.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@moluoxixi/config-form-compiler": "workspace:*",
    "@moluoxixi/config-form-model": "workspace:*",
    "@moluoxixi/config-form-source": "workspace:*",
    "@moluoxixi/config-form-studio": "workspace:*",
    "fflate": "catalog:",
    "zod": "catalog:dev"
  },
  "devDependencies": {
    "@playwright/test": "catalog:dev",
    "@types/node": "catalog:type",
    "typescript": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
