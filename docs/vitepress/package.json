{
  "name": "@moluoxixi/docs",
  "type": "module",
  "version": "0.1.15",
  "private": true,
  "scripts": {
    "build:workspace-ai-doc": "pnpm --filter @moluoxixi/ai-doc-assistant build",
    "build:workspace-components": "pnpm --filter @moluoxixi/components build",
    "build:workspace-rich-text-editor": "pnpm --filter @moluoxixi/rich-text-editor build",
    "build:workspace-theme": "pnpm --filter @moluoxixi/vitepress-theme-element-plus build",
    "build:workspace-content-packages": "pnpm build:workspace-components && pnpm build:workspace-ai-doc && pnpm build:workspace-rich-text-editor",
    "build:workspace-packages": "pnpm build:workspace-content-packages && pnpm build:workspace-theme",
    "predev": "pnpm build:workspace-theme",
    "dev": "element-plus-docs dev",
    "prebuild": "pnpm build:workspace-theme",
    "build": "element-plus-docs build",
    "preview": "vitepress preview",
    "prepare:docs": "element-plus-docs prepare",
    "generate-component-routes": "node scripts/generate-component-routes.mts",
    "generate-utility-routes": "node scripts/generate-utility-routes.mts",
    "preextract-api": "pnpm build:workspace-components && pnpm --filter @moluoxixi/ai-doc-assistant build",
    "extract-api": "node scripts/extract-api.mts",
    "pretest": "pnpm build:workspace-packages",
    "test": "vitest run",
    "pretypecheck": "pnpm build:workspace-packages",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "catalog:ui",
    "@moluoxixi/ai-doc-assistant": "workspace:*",
    "@moluoxixi/components": "workspace:*",
    "@moluoxixi/rich-text-editor": "workspace:*",
    "@moluoxixi/vitepress-theme-element-plus": "workspace:*",
    "@tanstack/vue-query": "catalog:data",
    "element-plus": "catalog:ui",
    "vue": "catalog:build"
  },
  "devDependencies": {
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:type",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/compiler-sfc": "catalog:dev",
    "happy-dom": "catalog:dev",
    "markdown-it": "catalog:",
    "typescript": "catalog:dev",
    "unplugin-auto-import": "catalog:dev",
    "unplugin-vue-components": "catalog:dev",
    "vite": "catalog:dev",
    "vitepress": "catalog:",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev",
    "yaml": "catalog:"
  }
}
