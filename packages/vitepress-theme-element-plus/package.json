{
  "name": "@moluoxixi/vitepress-theme-element-plus",
  "type": "module",
  "version": "0.1.8",
  "description": "Reusable Element Plus-style custom VitePress documentation theme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/vitepress-theme-element-plus"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown": {
      "source": "./markdown.ts",
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./repl": {
      "source": "./repl.ts",
      "types": "./dist/repl.d.ts",
      "import": "./dist/repl.js"
    },
    "./repl.css": "./src/repl/styles.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md",
    "dist",
    "index.ts",
    "markdown.ts",
    "repl.ts",
    "src"
  ],
  "scripts": {
    "build": "vite build && pnpm test:provenance",
    "dev": "vite build --watch",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "test:provenance": "node scripts/verify-dist.mjs",
    "build:fixture": "pnpm build && vitepress build fixtures/basic",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "peerDependencies": {
    "element-plus": "^2.9.0",
    "vitepress": "1.6.4",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "catalog:ui",
    "@mdit-vue/shared": "catalog:",
    "@moluoxixi/ai-doc-assistant": "workspace:*",
    "@vue/repl": "catalog:",
    "@vueuse/core": "catalog:",
    "lz-string": "catalog:",
    "markdown-it": "catalog:",
    "markdown-it-container": "catalog:",
    "normalize.css": "catalog:",
    "nprogress": "catalog:",
    "typescript": "catalog:dev",
    "vue3-sfc-loader": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:dev",
    "@types/markdown-it": "catalog:",
    "@types/markdown-it-container": "catalog:",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "element-plus": "catalog:ui",
    "happy-dom": "catalog:dev",
    "sass": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitepress": "catalog:",
    "vitest": "catalog:dev",
    "vue": "catalog:build",
    "vue-tsc": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
