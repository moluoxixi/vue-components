{
  "name": "@moluoxixi/components",
  "type": "module",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/components"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "import": "./dist/components.css"
    },
    "./element": {
      "source": "./element.ts",
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./antd": {
      "source": "./antd.ts",
      "types": "./dist/antd.d.ts",
      "import": "./dist/antd.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.2.0",
    "element-plus": "^2.9.0",
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "@moluoxixi/config-form-headless": "workspace:*",
    "@moluoxixi/hooks": "workspace:*",
    "dayjs": "catalog:build"
  },
  "devDependencies": {
    "@tanstack/vue-query": "catalog:data",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "ant-design-vue": "catalog:ui",
    "element-plus": "catalog:ui",
    "happy-dom": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:build",
    "vue-tsc": "catalog:dev",
    "zod": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
