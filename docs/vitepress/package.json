{
  "name": "@moluoxixi/docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:workspace-components": "pnpm --filter @moluoxixi/components build",
    "build:workspace-theme": "pnpm --filter @moluoxixi/vitepress-theme-element-plus build",
    "build:workspace-packages": "pnpm build:workspace-components && pnpm build:workspace-theme",
    "predev": "pnpm build:workspace-packages && pnpm extract-api && pnpm validate-github-metadata",
    "dev": "vitepress dev",
    "prebuild": "pnpm build:workspace-packages && pnpm extract-api && pnpm validate-github-metadata",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "sync-github-metadata": "node scripts/sync-github-metadata.mts",
    "validate-github-metadata": "node scripts/validate-github-metadata.mts",
    "preextract-api": "pnpm --filter @moluoxixi/ai-doc-assistant build",
    "extract-api": "node scripts/extract-api.mts",
    "pretest": "pnpm build:workspace-packages",
    "test": "vitest run",
    "pretypecheck": "pnpm build:workspace-packages",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "catalog:ui",
    "@moluoxixi/ai-doc-assistant": "workspace:*",
    "@moluoxixi/components": "workspace:*",
    "@moluoxixi/vitepress-theme-element-plus": "workspace:*",
    "@tanstack/vue-query": "catalog:data",
    "element-plus": "catalog:ui",
    "vue": "catalog:build",
    "vue3-sfc-loader": "catalog:"
  },
  "devDependencies": {
    "@types/markdown-it": "catalog:",
    "@types/markdown-it-container": "catalog:",
    "@types/node": "catalog:type",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/compiler-sfc": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "happy-dom": "catalog:dev",
    "markdown-it-container": "catalog:",
    "typescript": "catalog:dev",
    "unplugin-auto-import": "catalog:dev",
    "unplugin-vue-components": "catalog:dev",
    "vite": "catalog:dev",
    "vitepress": "catalog:",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev"
  }
}
