{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@docs-components": ["../../packages/components/index.ts"],
      "@docs-components/styles": ["../../packages/components/src/styles/index.scss"],
      "@moluoxixi/components/auto-loaders": ["../../packages/components/auto-loaders.ts"]
    },
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "vitest"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["env.d.ts", "vitest.config.ts", ".vitepress/**/*.ts", ".vitepress/**/*.d.ts", ".vitepress/**/*.vue", ".generated/types/**/*.d.ts", "scripts/**/*.mts", "scripts/**/*.ts"],
  "exclude": [".vitepress/cache", ".vitepress/dist", ".generated/api", ".generated/repository", "dist"]
}
