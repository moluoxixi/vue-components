{
  "name": "@moluoxixi/eslint-config",
  "type": "module",
  "version": "0.0.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moluoxixi/vue-components.git",
    "directory": "packages/eslint-config"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "eslint": "catalog:dev"
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "eslint-plugin-format": "catalog:dev"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:dev",
    "eslint": "catalog:dev",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
