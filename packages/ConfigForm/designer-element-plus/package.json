{
  "name": "@moluoxixi/config-form-designer-element-plus",
  "type": "module",
  "version": "0.1.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/ConfigForm/designer-element-plus"
  },
  "sideEffects": [
    "**/style/index.ts",
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "sass": "./src/styles/index.scss",
      "style": "./src/styles/index.scss",
      "default": "./src/styles/index.scss"
    },
    "./element-section/style": {
      "sass": "./src/components/ElementSection/style/index.scss",
      "style": "./src/components/ElementSection/style/index.scss",
      "default": "./src/components/ElementSection/style/index.scss"
    },
    "./element-flex-layout/style": {
      "sass": "./src/components/ElementFlexLayout/style/index.scss",
      "style": "./src/components/ElementFlexLayout/style/index.scss",
      "default": "./src/components/ElementFlexLayout/style/index.scss"
    },
    "./element-grid-layout/style": {
      "sass": "./src/components/ElementGridLayout/style/index.scss",
      "style": "./src/components/ElementGridLayout/style/index.scss",
      "default": "./src/components/ElementGridLayout/style/index.scss"
    },
    "./element-checkbox-field/style": {
      "sass": "./src/components/ElementCheckboxField/style/index.scss",
      "style": "./src/components/ElementCheckboxField/style/index.scss",
      "default": "./src/components/ElementCheckboxField/style/index.scss"
    },
    "./element-radio-field/style": {
      "sass": "./src/components/ElementRadioField/style/index.scss",
      "style": "./src/components/ElementRadioField/style/index.scss",
      "default": "./src/components/ElementRadioField/style/index.scss"
    },
    "./element-select-field/style": {
      "sass": "./src/components/ElementSelectField/style/index.scss",
      "style": "./src/components/ElementSelectField/style/index.scss",
      "default": "./src/components/ElementSelectField/style/index.scss"
    },
    "./element-option-state/style": {
      "sass": "./src/components/ElementOptionState/style/index.scss",
      "style": "./src/components/ElementOptionState/style/index.scss",
      "default": "./src/components/ElementOptionState/style/index.scss"
    },
    "./element-option-source-setter/style": {
      "sass": "./src/components/ElementOptionSourceSetter/style/index.scss",
      "style": "./src/components/ElementOptionSourceSetter/style/index.scss",
      "default": "./src/components/ElementOptionSourceSetter/style/index.scss"
    },
    "./element-choice-default-setter/style": {
      "sass": "./src/components/ElementChoiceDefaultSetter/style/index.scss",
      "style": "./src/components/ElementChoiceDefaultSetter/style/index.scss",
      "default": "./src/components/ElementChoiceDefaultSetter/style/index.scss"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "pnpm -w finalize:declarations --manifest \"$npm_package_json\"",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "@moluoxixi/config-form-designer": "^0.1.5",
    "@moluoxixi/config-form-model": "^0.1.0",
    "element-plus": "^2.9.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "catalog:ui"
  },
  "devDependencies": {
    "@moluoxixi/config-form-designer": "workspace:*",
    "@moluoxixi/config-form-model": "workspace:*",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "element-plus": "catalog:ui",
    "happy-dom": "catalog:dev",
    "sass": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:build",
    "vue-tsc": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
