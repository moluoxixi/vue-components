{
  "name": "@moluoxixi/config-form-designer",
  "type": "module",
  "version": "0.1.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/ConfigForm/designer"
  },
  "sideEffects": [
    "**/style/index.ts",
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "sass": "./src/styles.scss",
      "style": "./src/styles.scss",
      "default": "./src/styles.scss"
    },
    "./design-surface/style": {
      "sass": "./src/components/DesignSurface/style/index.scss",
      "style": "./src/components/DesignSurface/style/index.scss",
      "default": "./src/components/DesignSurface/style/index.scss"
    },
    "./designer-canvas/style": {
      "sass": "./src/components/DesignerCanvas/style/index.scss",
      "style": "./src/components/DesignerCanvas/style/index.scss",
      "default": "./src/components/DesignerCanvas/style/index.scss"
    },
    "./designer-palette/style": {
      "sass": "./src/components/DesignerPalette/style/index.scss",
      "style": "./src/components/DesignerPalette/style/index.scss",
      "default": "./src/components/DesignerPalette/style/index.scss"
    },
    "./designer-material-specimen/style": {
      "sass": "./src/components/DesignerMaterialSpecimen/style/index.scss",
      "style": "./src/components/DesignerMaterialSpecimen/style/index.scss",
      "default": "./src/components/DesignerMaterialSpecimen/style/index.scss"
    },
    "./designer-property-panel/style": {
      "sass": "./src/components/DesignerPropertyPanel/style/index.scss",
      "style": "./src/components/DesignerPropertyPanel/style/index.scss",
      "default": "./src/components/DesignerPropertyPanel/style/index.scss"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "pnpm -w finalize:declarations --manifest \"$npm_package_json\"",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "@lucide/vue": "catalog:ui",
    "@moluoxixi/config-form": "workspace:*",
    "@moluoxixi/config-form-core": "workspace:*",
    "@moluoxixi/config-form-headless": "workspace:*",
    "@moluoxixi/config-form-model": "workspace:*",
    "@moluoxixi/config-form-vue-backend": "workspace:*",
    "@moluoxixi/zod3-to-rule": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "happy-dom": "catalog:dev",
    "sass": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:build",
    "vue-tsc": "catalog:dev",
    "zod": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
