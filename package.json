{
  "name": "components",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.29.3"
  },
  "scripts": {
    "changeset": "changeset",
    "dev:components": "pnpm build && pnpm -C playgrounds/components-playground dev",
    "dev:ai-doc": "pnpm --filter @moluoxixi/ai-doc-assistant build && node packages/ai-doc-assistant/dist/cli.js serve --root D:/project-new/vue-component --entries packages/components/index.ts --host 127.0.0.1 --port 5173",
    "dev:config-form": "pnpm build && pnpm -C packages/ConfigForm/playground dev",
    "dev:vue-playground": "pnpm -C playgrounds/vue-playground dev",
    "build": "turbo run build --filter=\"./packages/**\" --filter=!@config-form/playground",
    "build:docs": "pnpm -C docs/vitepress build",
    "build:force": "turbo run build --force --filter=\"./packages/**\" --filter=!@config-form/playground",
    "build:pages": "node scripts/build-pages.mjs",
    "build:playgrounds": "pnpm -r --filter \"./packages/ConfigForm/playground\" --filter \"./playgrounds/*\" build",
    "finalize:declarations": "node scripts/finalize-published-declarations.mjs",
    "lint": "node scripts/check-element-plus-imports.mjs && eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "pre-commit": "node scripts/check-element-plus-imports.mjs && pnpm lint:staged",
    "release": "pnpm release:check && pnpm build:force && pnpm test:pack && changeset publish",
    "release:check": "node scripts/check-workspace-peer-ranges.mjs && pnpm lint:workflows",
    "release:changesets": "node scripts/auto-changesets.mjs",
    "test": "turbo run test --filter=\"./packages/**\" --filter=\"./docs/**\" --filter=!@config-form/playground --filter=!@moluoxixi/vite-config && turbo run test --filter=@moluoxixi/vite-config --concurrency=1 && pnpm test:config-form-packages",
    "test:config-form-packages": "turbo run build --filter=@moluoxixi/config-form-headless --filter=@moluoxixi/config-form --filter=@moluoxixi/config-form-designer --filter=@moluoxixi/config-form-element --filter=@moluoxixi/config-form-antd-vue --filter=\"./packages/ConfigForm/plugin-*\" --filter=@moluoxixi/config-form-designer-element-plus --filter=@moluoxixi/config-form-designer-antd-vue && node scripts/verify-config-form-adapter-packages.mjs",
    "test:coverage": "turbo run test:coverage --filter=@moluoxixi/ai-doc-assistant --filter=@moluoxixi/ajax-package --filter=@moluoxixi/config-form-devtools-vite-plugin --filter=@moluoxixi/config-form-plugin-antd-vue --filter=@moluoxixi/config-form-plugin-element-plus --filter=@moluoxixi/config-form --filter=@moluoxixi/eslint-config --filter=@moluoxixi/excel --filter=@moluoxixi/hooks --filter=@moluoxixi/indexed-db --filter=@moluoxixi/postcss-selector-prefix --filter=@moluoxixi/utils && turbo run test:coverage --filter=@moluoxixi/vite-config --concurrency=1",
    "test:path-contracts": "vitest run scripts/__tests__/path-conventions.test.mjs && pnpm --filter @config-form/components-playground typecheck",
    "test:release": "vitest run scripts/__tests__/auto-changesets.test.mjs scripts/__tests__/published-package-verifier.test.mjs scripts/__tests__/release-workflows.test.mjs && pnpm test:path-contracts",
    "test:e2e:config-form": "pnpm build && pnpm -C packages/ConfigForm/playground test:e2e",
    "test:e2e:components": "pnpm build && pnpm -C playgrounds/components-playground test:e2e",
    "test:e2e": "pnpm test:e2e:config-form && pnpm test:e2e:components",
    "pretest:pack": "pnpm build",
    "test:pack": "node scripts/verify-published-packages.mjs",
    "pretest:pack:browser": "pnpm build",
    "test:pack:browser": "node scripts/verify-published-packages.mjs --browser",
    "lint:workflows": "node scripts/validate-workflows.mjs",
    "typecheck": "turbo run typecheck --filter=\"./packages/**\" --filter=\"./playgrounds/**\" --filter=\"./docs/**\"",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "@types/node": "catalog:type",
    "@vue/compiler-dom": "catalog:dev",
    "@vue/compiler-sfc": "catalog:dev",
    "@vue/server-renderer": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "husky": "catalog:dev",
    "jiti": "catalog:dev",
    "lint-staged": "catalog:dev",
    "publint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "yaml": "catalog:"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,vue}": "eslint --fix"
  }
}
