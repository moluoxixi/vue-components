# AI 文档助手配置示例（真实值请复制到 .env.local，勿提交真实 key）
# provider: openai | anthropic | google | openai-compatible
AI_DOC_CHAT_PROVIDER=openai-compatible
AI_DOC_CHAT_API_KEY=
AI_DOC_CHAT_MODEL=
AI_DOC_CHAT_BASE_URL=https://gateway.example/v1

# vector 模式会把组件契约正文发送给所选远程 embedding Provider，并可能产生费用。
# provider: openai | google | openai-compatible
AI_DOC_EMBEDDING_PROVIDER=openai-compatible
AI_DOC_EMBEDDING_API_KEY=
AI_DOC_EMBEDDING_MODEL=
AI_DOC_EMBEDDING_BASE_URL=https://gateway.example/v1
