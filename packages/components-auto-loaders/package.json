  },
  "devDependencies": {
    "@moluoxixi/components": "workspace:*",
    "@types/node": "catalog:type",
    "@vitest/coverage-v8": "catalog:dev",
    "unplugin-auto-import": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "unplugin-vue-components": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
