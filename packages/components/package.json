{
  "name": "@moluoxixi/components",
  "type": "module",
  "version": "0.4.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/components"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "imports": {
    "#components/*": {
      "source": "./src/*/index.ts",
      "types": "./dist/src/*/index.d.ts",
      "default": "./src/*/index.ts"
    }
  },
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto-loaders": {
      "source": "./auto-loaders.ts",
      "types": "./dist/auto-loaders.d.ts",
      "import": "./dist/auto-loaders.js"
    },
    "./playground-manifest": {
      "types": "./dist/playground-manifest.d.ts",
      "import": "./dist/playground-manifest.js"
    },
    "./styles": {
      "import": "./dist/components.css"
    },
    "./ConfigTable": {
      "source": "./src/ConfigTable/index.ts",
      "types": "./dist/src/ConfigTable/index.d.ts",
      "import": "./dist/ConfigTable.js"
    },
    "./CopyText": {
      "source": "./src/CopyText/index.ts",
      "types": "./dist/src/CopyText/index.d.ts",
      "import": "./dist/CopyText.js"
    },
    "./DateRangePicker": {
      "source": "./src/DateRangePicker/index.ts",
      "types": "./dist/src/DateRangePicker/index.d.ts",
      "import": "./dist/DateRangePicker.js"
    },
    "./EnterNextContainer": {
      "source": "./src/EnterNextContainer/index.ts",
      "types": "./dist/src/EnterNextContainer/index.d.ts",
      "import": "./dist/EnterNextContainer.js"
    },
    "./HeadlessCopyText": {
      "source": "./src/HeadlessCopyText/index.ts",
      "types": "./dist/src/HeadlessCopyText/index.d.ts",
      "import": "./dist/HeadlessCopyText.js"
    },
    "./HeadlessTable": {
      "source": "./src/HeadlessTable/index.ts",
      "types": "./dist/src/HeadlessTable/index.d.ts",
      "import": "./dist/HeadlessTable.js"
    },
    "./PopoverTableSelect": {
      "source": "./src/PopoverTableSelect/index.ts",
      "types": "./dist/src/PopoverTableSelect/index.d.ts",
      "import": "./dist/PopoverTableSelect.js"
    },
    "./RequestCascader": {
      "source": "./src/RequestCascader/index.ts",
      "types": "./dist/src/RequestCascader/index.d.ts",
      "import": "./dist/RequestCascader.js"
    },
    "./RequestSelectV2": {
      "source": "./src/RequestSelectV2/index.ts",
      "types": "./dist/src/RequestSelectV2/index.d.ts",
      "import": "./dist/RequestSelectV2.js"
    },
    "./RequestTreeSelect": {
      "source": "./src/RequestTreeSelect/index.ts",
      "types": "./dist/src/RequestTreeSelect/index.d.ts",
      "import": "./dist/RequestTreeSelect.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "auto-loaders.ts",
    "dist",
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "node scripts/generate-playground-manifest.mjs && pnpm -w finalize:declarations --manifest \"$npm_package_json\"",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "element-plus": "^2.9.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:ui",
    "@lucide/vue": "catalog:ui",
    "@moluoxixi/hooks": "workspace:*",
    "dayjs": "catalog:build",
    "sortablejs": "catalog:"
  },
  "devDependencies": {
    "@tanstack/vue-query": "catalog:data",
    "@types/sortablejs": "catalog:",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "element-plus": "catalog:ui",
    "esbuild": "catalog:dev",
    "happy-dom": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:build",
    "vue-tsc": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
