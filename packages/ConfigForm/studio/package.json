{
  "name": "@moluoxixi/config-form-studio",
  "type": "module",
  "version": "0.1.1",
  "description": "Portable ConfigForm authoring and standalone Vue source SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/ConfigForm/studio"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "source": "./src/client/index.ts",
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/client.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "pnpm -w finalize:declarations --manifest \"$npm_package_json\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@moluoxixi/config-form-model": "workspace:*",
    "@moluoxixi/config-form-source": "workspace:*"
  },
  "devDependencies": {
    "@moluoxixi/config-form-compiler": "workspace:*",
    "typescript": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
