{
  "name": "@moluoxixi/components",
  "type": "module",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/components"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "import": "./dist/components.css"
    },
    "./element": {
      "source": "./element.ts",
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./antd": {
      "source": "./antd.ts",
      "types": "./dist/antd.d.ts",
      "import": "./dist/antd.js"
    },
    "./autoComponent": {
      "source": "./autoComponent.ts",
      "types": "./dist/autoComponent.d.ts",
      "import": "./dist/autoComponent.js"
    },
    "./autoImport": {
      "source": "./autoImport.ts",
      "types": "./dist/autoImport.d.ts",
      "import": "./dist/autoImport.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "antd.ts",
    "autoComponent.ts",
    "autoImport.ts",
    "dist",
    "element.ts",
    "index.ts",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.2.0",
    "element-plus": "^2.9.0",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.4.1",
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "unplugin-auto-import": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:ui",
    "@lucide/vue": "catalog:ui",
    "@moluoxixi/config-form": "workspace:*",
    "@moluoxixi/config-form-headless": "workspace:*",
    "@moluoxixi/hooks": "workspace:*",
    "@tiptap/core": "catalog:ui",
    "@tiptap/extension-placeholder": "catalog:ui",
    "@tiptap/extension-text-align": "catalog:ui",
    "@tiptap/pm": "catalog:ui",
    "@tiptap/starter-kit": "catalog:ui",
    "@tiptap/vue-3": "catalog:ui",
    "dayjs": "catalog:build"
  },
  "devDependencies": {
    "@tanstack/vue-query": "catalog:data",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "ant-design-vue": "catalog:ui",
    "element-plus": "catalog:ui",
    "happy-dom": "catalog:dev",
    "unplugin-auto-import": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "unplugin-vue-components": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:build",
    "vue-tsc": "catalog:dev",
    "zod": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
