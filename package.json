{
  "name": "components",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.29.3"
  },
  "scripts": {
    "changeset": "changeset",
    "dev:components": "pnpm build && pnpm -C playgrounds/components-playground dev",
    "dev:ai-doc": "pnpm --filter @moluoxixi/ai-doc-assistant build && node packages/ai-doc-assistant/dist/cli.js serve --root D:/project-new/vue-component --entries packages/components/index.ts --host 127.0.0.1 --port 5173",
    "dev:config-form": "pnpm build && pnpm -C packages/ConfigForm/playground dev",
    "dev:vue-playground": "pnpm -C playgrounds/vue-playground dev",
    "build": "pnpm -r --filter \"./packages/**\" --filter \"!./packages/ConfigForm/playground\" build",
    "build:pages": "node scripts/build-pages.mjs",
    "build:playgrounds": "pnpm -r --filter \"./packages/ConfigForm/playground\" --filter \"./playgrounds/*\" build",
    "lint": "node scripts/check-element-plus-imports.mjs && eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "pre-commit": "node scripts/check-element-plus-imports.mjs && pnpm lint:staged",
    "release": "pnpm release:check && pnpm build && changeset publish",
    "release:check": "node scripts/check-workspace-peer-ranges.mjs",
    "release:changesets": "node scripts/auto-changesets.mjs",
    "test": "pnpm -C packages/ConfigForm/runtime build && pnpm -r --filter \"./packages/**\" test && pnpm --filter @moluoxixi/docs test && pnpm test:config-form-packages",
    "test:config-form-packages": "pnpm -r --filter \"@moluoxixi/config-form-headless\" --filter \"@moluoxixi/config-form\" --filter \"@moluoxixi/config-form-designer\" --filter \"@moluoxixi/config-form-element\" --filter \"@moluoxixi/config-form-antd-vue\" --filter \"./packages/ConfigForm/plugin-*\" --filter \"@moluoxixi/config-form-designer-element-plus\" --filter \"@moluoxixi/config-form-designer-antd-vue\" build && node scripts/verify-config-form-adapter-packages.mjs",
    "test:coverage": "pnpm -C packages/ConfigForm/runtime build && pnpm -r --filter \"./packages/**\" test:coverage",
    "test:release": "vitest run scripts/__tests__/auto-changesets.test.mjs",
    "test:e2e:config-form": "pnpm build && pnpm -C packages/ConfigForm/playground test:e2e",
    "test:e2e:components": "pnpm build && pnpm -C playgrounds/components-playground test:e2e",
    "typecheck": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./packages/**\" --filter \"./playgrounds/*\" --filter \"./docs/**\" typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@changesets/cli": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "@types/node": "catalog:type",
    "@vue/compiler-dom": "catalog:dev",
    "@vue/compiler-sfc": "catalog:dev",
    "@vue/server-renderer": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "husky": "catalog:dev",
    "jiti": "catalog:dev",
    "lint-staged": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,vue}": "eslint --fix"
  }
}
