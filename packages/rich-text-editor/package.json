{
  "name": "@moluoxixi/rich-text-editor",
  "type": "module",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/moluoxixi/vue-components",
    "directory": "packages/rich-text-editor"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles": {
      "import": "./dist/rich-text-editor.css"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "pnpm -w finalize:declarations --manifest \"$npm_package_json\"",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/extension-text-align": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/vue-3": "^3.29.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "catalog:ui"
  },
  "devDependencies": {
    "@tiptap/core": "catalog:ui",
    "@tiptap/extension-placeholder": "catalog:ui",
    "@tiptap/extension-text-align": "catalog:ui",
    "@tiptap/starter-kit": "catalog:ui",
    "@tiptap/vue-3": "catalog:ui",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "happy-dom": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-dts": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vue": "catalog:build",
    "vue-tsc": "catalog:dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
